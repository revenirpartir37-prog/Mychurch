# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# SMTP (RECOMMANDÉ — gratuit, envoie à n'importe quel destinataire, sans domaine payant)
# Avec Gmail : activer la double authentification puis créer un "mot de passe d'application"
# (Mon compte Google → Sécurité → Mots de passe d'application). Utiliser CE mot de passe, pas votre vrai mot de passe.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Resend (Email OTP / Bienvenue / Mot de passe oublié) — fallback si SMTP non configuré.
# NB : sans domaine vérifié, Resend ne peut envoyer que vers votre propre email (sandbox).
RESEND_API_KEY=
# Expéditeur utilisé en priorité (par défaut : SMTP_USER / sinon onboarding@resend.dev)
EMAIL_FROM=

# OneSignal (Push Notifications)
# appId : public, visible côté client. REST API Key : SECRÈTE, côté serveur uniquement.
NEXT_PUBLIC_ONESIGNAL_APP_ID=976aaaf5-5bd3-4abe-8d3b-4863e121deb7
ONESIGNAL_REST_API_KEY=
# Secret optionnel pour appeler /api/notifications/reminders en tâche planifiée
NOTIFICATIONS_CRON_SECRET=
# Secret Vercel Cron (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# JWT (signature du token d'application émis après vérification Supabase Auth)
# IMPORTANT pour la production : remplacez les valeurs par des secrets forts.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Supabase (Auth + Storage + Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_BUCKET=Mychurch-bucket

# Database — Supabase PostgreSQL (session pooler, port 5432)
# Il faut aussi définir la variable DATABASE_URL dans le déploiement
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
# Connexion directe Supabase (port 5432) — pour migrations/scripts lourds
# DIRECT_DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
